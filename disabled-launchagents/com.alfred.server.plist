<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alfred.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/carltonking/01 - PROJECTS/ALFRED/alfred/server/alfred_server.py</string>
        <string>serve</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Keep the hub alive: crash or exit -> relaunch. -->
    <key>KeepAlive</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/carltonking/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/carltonking/.alfred/logs/server.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/carltonking/.alfred/logs/server.err</string>
</dict>
</plist>
