{
  "outputDirectory": "website",
  "functions": {
    "api/telegram.ts": { "maxDuration": 300 },
    "api/app.ts": { "maxDuration": 60 },
    "api/cron-briefing.ts": { "maxDuration": 60 },
    "api/cron-departure.ts": { "maxDuration": 60 },
    "api/cron-routines.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron-briefing", "schedule": "0 10 * * *" },
    { "path": "/api/cron-briefing", "schedule": "0 11 * * *" }
  ],
  "rewrites": [
    { "source": "/api/telegram", "destination": "/api/telegram" }
  ]
}
