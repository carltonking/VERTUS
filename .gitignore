# Secrets — NEVER commit
.env
.env.local

# Generated state / runtime data (live in ~/.alfred/)
*.db
hud_history.jsonl
me.md
.kokoro_disabled
.alfred_trash/
.jarvis_trash/

# Python
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/

# Python virtualenvs — NEVER commit (huge, machine-specific)
alfred_env/
venv/
.venv/
env/
**/site-packages/

# Swift build artifacts
.build/
**/.build/
.swiftpm/
**/.swiftpm/
AlfredMac/.build/
AlfredMac/build/
AlfredMac/*.xcodeproj/
AlfredMac/.swiftpm/
AlfredBar/AlfredBar
AlfredBar/.build/
AlfredBar/*.xcodeproj/
Alfred/build/

# Xcode per-user state — window positions and scheme ordering, not project configuration
**/xcuserdata/
*.xcuserstate

# Local app/release artifacts
*.app/
*.dmg

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*~
.vercel
node_modules/
.env*.local

# Vendored engines and external repos — never commit
AlfredMac/Frameworks/
AlfredMac/Server/MiniOmni/
freellmpool/

# Python virtualenvs (agent-bridge, voice bridge)
.venvs/

# Runtime state (stream store, session bins)
data/

