# Alfred configuration — copy this to .env and fill in your keys.
# Or just run `python3 assistant.py --setup` for a guided wizard.

# ─── FREE PROVIDERS (recommended) ─────────────────────────────────────────

# Google Gemini — best free model (Gemini 2.0 Flash), vision support, 1M context
# Get one: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

# Groq — fastest free inference (Llama 3.3 70B)
# Get one: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Cerebras — ultra-fast free inference (Llama 3.3 70B)
# Get one: https://cloud.cerebras.ai
# CEREBRAS_API_KEY=csk-...

# OpenRouter — one key for 100+ models, many free
# Get one: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Mistral — affordable European AI
# Get one: https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=

# ─── PAID PROVIDERS ────────────────────────────────────────────────────────
# Anthropic API key. Powers Claude.
# Get one: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── OPTIONAL ──────────────────────────────────────────────────────────────

# Deepgram — for voice-only mode (mode 1). Skip if you only use the text bar.
# Get one: https://console.deepgram.com/   (45,000 free min)
# DEEPGRAM_API_KEY=

# AMD SGLang / Fireworks — routes fast queries through alternate inference for
# speed and cost. Skip both lines to use Claude directly for everything.
# Fireworks endpoint:  https://api.fireworks.ai/inference/v1
# Fireworks key:       starts with fw_...
# Fireworks model:     accounts/fireworks/models/qwen2p5-72b-instruct
# AMD_SGLANG_URL=
# AMD_SGLANG_KEY=
# AMD_SGLANG_MODEL=alfred-fast

# Brave Search — better web search than the free DuckDuckGo fallback.
# Get one: https://brave.com/search/api/   (2,000 free queries/month)
# BRAVE_API_KEY=
